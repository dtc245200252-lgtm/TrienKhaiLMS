
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Lớp học phần | ICTU LMS Mini</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="main" style="margin-left:0">
    <header class="topbar">
      <a href="/">← Quay lại bảng tin LMS</a>
      <strong>LỚP HỌC PHẦN</strong>
    </header>

    <section class="content">
      <h1>Danh sách lớp học phần</h1>
      <p>Danh sách được truy vấn trực tiếp từ cơ sở dữ liệu MySQL.</p>

      <form method="GET" action="/courses" style="margin-bottom:20px">
        <input
          type="search"
          name="q"
          value="<%= q %>"
          placeholder="Tìm theo mã hoặc tên học phần"
          aria-label="Tìm học phần"
        >
        <button type="submit">Tìm kiếm</button>
        <a href="/courses">Xóa tìm kiếm</a>
      </form>

      <p>Tìm thấy <strong><%= courses.length %></strong> học phần.</p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>STT</th>
              <th>Mã học phần</th>
              <th>Tên học phần</th>
              <th>Giảng viên</th>
              <th>Tín chỉ</th>
              <th>Tuần học</th>
              <th>Buổi nghỉ</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody>
            <% if (courses.length === 0) { %>
              <tr>
                <td colspan="8">Không tìm thấy học phần phù hợp.</td>
              </tr>
            <% } %>

            <% courses.forEach((course, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= course.course_code %></td>
                <td><%= course.course_name %></td>
                <td><%= course.lecturer || 'Chưa cập nhật' %></td>
                <td><%= course.credits %></td>
                <td><%= course.total_weeks %></td>
                <td><%= course.absences %></td>
                <td><%= course.status %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
