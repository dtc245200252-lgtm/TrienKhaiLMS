<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Bài học | ICTU LMS Mini</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="main" style="margin-left:0">
    <header class="topbar">
      <a href="/">← Quay lại bảng tin LMS</a>
      <strong>BÀI HỌC</strong>
    </header>
    <section class="content">
      <h1>Danh sách bài học</h1>
      <form method="GET" action="/lessons" style="margin-bottom:20px">
        <select name="course_id" aria-label="Chọn khóa học">
          <option value="0">Tất cả khóa học</option>
          <% courses.forEach(c => { %>
            <option value="<%= c.id %>" <%= c.id === courseId ? 'selected' : '' %>>
              <%= c.course_code %> - <%= c.course_name %>
            </option>
          <% }) %>
        </select>
        <button type="submit">Lọc</button>
      </form>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Khóa học</th><th>Bài</th><th>Tiêu đề</th><th>Nội dung</th></tr>
          </thead>
          <tbody>
            <% if (lessons.length === 0) { %>
              <tr><td colspan="4">Chưa có bài học.</td></tr>
            <% } %>
            <% lessons.forEach(l => { %>
              <tr>
                <td><%= l.course_code %> - <%= l.course_name %></td>
                <td><%= l.lesson_no %></td>
                <td><%= l.title %></td>
                <td><%= l.content || '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>