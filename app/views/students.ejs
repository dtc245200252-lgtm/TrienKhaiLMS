<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Học viên | ICTU LMS Mini</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="main" style="margin-left:0">
    <header class="topbar">
      <a href="/">← Quay lại bảng tin LMS</a>
      <strong>HỌC VIÊN</strong>
    </header>
    <section class="content">
      <h1>Danh sách học viên</h1>
      <% if (error) { %><p><strong><%= error %></strong></p><% } %>

      <form method="POST" action="/students" style="margin-bottom:20px">
        <input name="student_code" placeholder="Mã học viên" required maxlength="20">
        <input name="full_name" placeholder="Họ và tên" required maxlength="100">
        <input name="email" type="email" placeholder="Email" required maxlength="120">
        <button type="submit">Thêm học viên</button>
      </form>

      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>STT</th><th>Mã</th><th>Họ và tên</th><th>Email</th><th>Ngày tạo</th></tr>
          </thead>
          <tbody>
            <% students.forEach((s, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= s.student_code %></td>
                <td><%= s.full_name %></td>
                <td><%= s.email %></td>
                <td><%= new Date(s.created_at).toLocaleString('vi-VN') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>